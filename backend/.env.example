# CareerMind AI 后端环境变量示例
# 复制本文件为 backend/.env 后填写真实密钥：
#   Copy-Item .env.example .env
# 请勿把包含真实密钥的 .env 提交到 Git。

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=CareerMind AI
APP_VERSION=1.0.0
APP_DEBUG=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# SQLite business database and LangGraph checkpoint database
# 相对路径以 backend/ 为运行目录。
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/careermind.db
CHECKPOINT_DB_PATH=./data/langgraph_checkpoints.db

# -----------------------------------------------------------------------------
# JWT
# 部署或共享项目时必须替换为足够长的随机字符串。
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# DashScope LLM (OpenAI-compatible API)
# -----------------------------------------------------------------------------
LLM_PROVIDER=dashscope
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_MODEL=qwen3.8-flash
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_TEMPERATURE=0.3
LLM_ENABLE_THINKING=false

# 单次底层传输超时、包含重试的总操作超时、模型客户端重试次数
LLM_TIMEOUT_SECONDS=120
LLM_OPERATION_TIMEOUT_SECONDS=250
LLM_MAX_RETRIES=1

# -----------------------------------------------------------------------------
# DashScope Embedding
# text-embedding-v3 单批最多 10 条。
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SECONDS=45
EMBEDDING_MAX_RETRIES=1

# -----------------------------------------------------------------------------
# Upload and CORS
# CORS_ORIGINS 必须是合法 JSON 数组。
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# -----------------------------------------------------------------------------
# Chroma vector store
# -----------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db

# -----------------------------------------------------------------------------
# External search APIs
# JSearch host 必须与申请 API Key 的服务商匹配。
# 当前适配器使用 https://<host>/jsearch/search-v2 和 X-API-Key。
# -----------------------------------------------------------------------------
JSEARCH_API_KEY=your-jsearch-api-key
JSEARCH_RAPIDAPI_HOST=api.openwebninja.com
JSEARCH_MAX_RESULTS=20
JSEARCH_TIMEOUT_SECONDS=30

TAVILY_API_KEY=your-tavily-api-key
TAVILY_MAX_RESULTS=10
TAVILY_TIMEOUT_SECONDS=30

EXTERNAL_API_MAX_RETRIES=1
EXTERNAL_API_RETRY_BACKOFF_SECONDS=1
LEARNING_RESOURCE_CONCURRENCY=3

# 复习巩固模式下，RAG 面试题与目标岗位的最低向量相似度
INTERVIEW_RAG_MIN_SCORE=0.5

# -----------------------------------------------------------------------------
# Hybrid Search + local BGE Reranker
# -----------------------------------------------------------------------------
HYBRID_CANDIDATE_LIMIT=50
HYBRID_RRF_K=60
RERANK_FINAL_LIMIT=20

BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
BGE_RERANK_MODEL_DIR=./venv/models/bge-reranker-v2-m3
# auto 会优先使用可用的 CUDA，否则使用 CPU；也可明确设置 cpu 或 cuda。
BGE_RERANK_DEVICE=auto
BGE_RERANK_BATCH_SIZE=8
BGE_RERANK_MAX_LENGTH=512
BGE_RERANK_TIMEOUT_SECONDS=20

# -----------------------------------------------------------------------------
# LangGraph
# -----------------------------------------------------------------------------
AGENT_RECURSION_LIMIT=25
